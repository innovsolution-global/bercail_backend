# =============================================================================
#  LE BERCAIL — Configuration
#  Copiez ce fichier en `.env` et adaptez les valeurs.
#  Aucun secret réel ne doit être commité.
# =============================================================================

# ── Application ──────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
API_URL=http://localhost:3000
LOG_LEVEL=debug

# Origines autorisées (React admin, Flutter web, outils locaux), séparées par des virgules.
# 5173 : serveur de dev du back-office React. Port fixe (strictPort dans
# vite.config.ts) : sans cela Vite derive sur un autre port et l'origine
# n'est plus reconnue ici.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8080

# Documentation Swagger sur /docs. À laisser à false en production.
SWAGGER_ENABLED=true

# ── Base de données ──────────────────────────────────────────────────────────
DATABASE_URL=postgresql://bercail:bercail@localhost:5432/bercail?schema=public

# ── Redis ────────────────────────────────────────────────────────────────────
# L'API démarre en mode dégradé (sans cache) si Redis est injoignable.
REDIS_URL=redis://localhost:6379
REDIS_ENABLED=true
REDIS_PREFIX=bercail:

# ── JWT ──────────────────────────────────────────────────────────────────────
# En production : 32 caractères minimum, valeurs DIFFÉRENTES entre les deux.
# Générer avec : node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
JWT_ACCESS_EXPIRES_IN=15m
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_EXPIRES_IN=30d
JWT_REFRESH_TTL_SECONDS=2592000
JWT_ISSUER=le-bercail
JWT_AUDIENCE=le-bercail-clients

# ── Sécurité ─────────────────────────────────────────────────────────────────
BCRYPT_ROUNDS=12
PASSWORD_MIN_LENGTH=8
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
ACTIVATION_TOKEN_TTL_HOURS=72
RESET_TOKEN_TTL_MINUTES=30

# ── Limitation de débit ──────────────────────────────────────────────────────
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=120
# Échappatoire réservée aux suites de tests, qui enchaînent volontairement les
# connexions. Sans effet en production, quelle que soit sa valeur.
THROTTLE_DISABLED=false

# ── Code de livraison (OTP) ──────────────────────────────────────────────────
OTP_LENGTH=4
OTP_TTL_MINUTES=60
OTP_MAX_ATTEMPTS=5

# ── Cache ────────────────────────────────────────────────────────────────────
CACHE_MENU_TTL_SECONDS=300
CACHE_SETTINGS_TTL_SECONDS=600

# ── Commandes ────────────────────────────────────────────────────────────────
ORDER_CANCEL_WINDOW_MINUTES=10
ORDER_REFERENCE_PREFIX=BRC

# ── Stockage des fichiers ────────────────────────────────────────────────────
# local (développement) ou s3 (production, tout stockage compatible S3).
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=uploads
STORAGE_PUBLIC_URL=http://localhost:3000/uploads
STORAGE_MAX_FILE_SIZE=5242880
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

# -- E-mails -----------------------------------------------------------------
# noop (journalise le message, aucun envoi) ou smtp.
# En `noop`, le mot de passe engendre apparait dans les logs du serveur :
# suffisant pour developper sans compte SMTP.
MAIL_DRIVER=noop
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=
# Gmail refuse le mot de passe du compte : il faut un MOT DE PASSE
# D'APPLICATION de 16 caracteres, cree sur https://myaccount.google.com/apppasswords
# (la validation en deux etapes doit etre active sur le compte).
MAIL_PASSWORD=
MAIL_FROM=Les Saveurs du Bercail <no-reply@lebercail.gn>

# Racine du back-office, utilisee pour construire les liens des e-mails.
BACK_OFFICE_URL=http://localhost:5173

# ── Notifications push ───────────────────────────────────────────────────────
# noop (journalise seulement) ou fcm.
PUSH_DRIVER=noop
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=

# ── Paiements ────────────────────────────────────────────────────────────────
# En bac à sable, les paiements mobiles sont simulés localement.
PAYMENT_SANDBOX=true
ORANGE_MONEY_ENABLED=true
ORANGE_MONEY_BASE_URL=
ORANGE_MONEY_MERCHANT_ID=
ORANGE_MONEY_API_KEY=
MTN_MONEY_ENABLED=true
MTN_MONEY_BASE_URL=
MTN_MONEY_MERCHANT_ID=
MTN_MONEY_API_KEY=
CARD_PAYMENT_ENABLED=false
CARD_PUBLIC_KEY=
CARD_SECRET_KEY=

# ── Compte SUPER_ADMIN initial (seed) ────────────────────────────────────────
# À changer impérativement avant toute mise en production.
SUPER_ADMIN_EMAIL=superadmin@lebercail.gn
SUPER_ADMIN_PASSWORD=SuperAdmin@2024
SUPER_ADMIN_PHONE=+224620000001

# ── Observabilité ────────────────────────────────────────────────────────────
SENTRY_DSN=
METRICS_ENABLED=false

# ── Synchronisation local ↔ en ligne ────────────────────────────────────────
# Le restaurant tourne sur un serveur posé sur place ; un second serveur, en
# ligne, sert l'application mobile. C'est TOUJOURS le serveur local qui
# engage l'échange : il est derrière la box de l'établissement et ne peut pas
# être appelé depuis l'extérieur.
SYNC_ENABLED=false
# LOCAL (serveur du restaurant) ou CLOUD (serveur en ligne).
SYNC_NODE=LOCAL
# Renseignée uniquement côté LOCAL : l'adresse publique du serveur en ligne.
SYNC_PEER_URL=https://api.lebercail.gn
# Secret partagé entre les deux serveurs — jamais un jeton d'utilisateur.
# À engendrer avec : openssl rand -base64 48
SYNC_SECRET=
# Intervalle entre deux tentatives d'échange, en secondes.
SYNC_INTERVAL_SECONDS=20
# Nombre d'écritures transmises par lot.
SYNC_BATCH_SIZE=200

# Sur le serveur EN LIGNE, marquer aussi l'identité du nœud dans la base
# elle-même (un pool rouvre des connexions en permanence, un réglage de
# session finirait par manquer sur l'une d'elles) :
#     ALTER DATABASE <base> SET app.sync_node = 'CLOUD';
#
# Et donner aux deux serveurs des préfixes de référence distincts, pour que
# deux commandes créées hors ligne ne puissent pas porter le même numéro :
#     ORDER_REFERENCE_PREFIX=BRC   (local)   /   BRO   (en ligne)
